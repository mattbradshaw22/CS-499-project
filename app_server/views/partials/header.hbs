{{!--
  Header Partial
  Used on all pages. The home, about, intake, find, and all variables are set
  in route controllers so the current navigation link can be highlighted.
--}}

{{!-- Site Header and Navigation --}}
<header class="site-header wrap">
    <a class="brand" href="/">
        <img class="brand-logo" src="/images/grazioso_salvare_logo.png" alt="Grazioso Salvare">
        <span>Animal Rescue System</span>
    </a>

    <nav>
        <a href="/" class="{{#if home}}active{{/if}}">Home</a>
        <a href="/about" class="{{#if about}}active{{/if}}">About</a>
        <a href="/animal-intake" class="{{#if intake}}active{{/if}}">Animal Intake</a>
        <a href="/find-an-animal" class="{{#if find}}active{{/if}}">Find an Animal</a>
        <a href="/rescue_animals" class="{{#if all}}active{{/if}}">See All Animals</a> 
    </nav>
</header>
